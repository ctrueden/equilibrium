{%- comment -%}
Display chronological session-based descriptions (the "Chronicle"):
one compact row per session, tagged with a link to its episode.
{%- endcomment -%}

{%- if page.descriptions %}
<div class="chronicle">
  <h2>Chronicle</h2>
  {%- assign sorted = page.descriptions | sort: "session" %}
  <dl>
  {%- for desc in sorted %}
    {%- unless desc.content == "" %}
    <dt><a href="{{ site.baseurl }}/events/case-{{ desc.session }}">{{ desc.session }}</a></dt>
    <dd>{{ desc.content | markdownify }}</dd>
    {%- endunless %}
  {%- endfor %}
  </dl>
</div>
{% endif -%}

